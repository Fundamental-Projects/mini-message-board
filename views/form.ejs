<form method="POST" action="/new">
  <label for="user-name">Name</label>
  <input type="text" placeholder="Write your name" name="user" id="user-name" />
  <label for="user-message">Your Message</label>
  <input type="text" placeholder="Write your message" name="message" id="user-message" />
  <button type="submit">Submit</button>
</form>
