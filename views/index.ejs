<!-- index.ejs -->
<html>
  <head>
    <title><%= title %></title>
  </head>
  <body>

    <ul>
      <% messages.forEach((message,i) => { %>
        <%- include('messages/message', {user: message.user, message:message.text, date:message.added, index:i}); %>
      <% }); %>

    </ul>
     <div>
      <a href="/new">New Message</a>
    </div>

    <%- include('footer') %>

  </body>
</html>
