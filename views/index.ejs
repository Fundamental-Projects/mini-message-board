<!-- index.ejs -->
<html>
  <head>
    <title><%= title %></title>
  </head>
  <body>
    <div>
      <%- include("form") %>
    </div>
    <ul>
      <% messages.forEach((message,i) => { %>
        <%- include('messages/message', {user: message.user, message:message.text, date:message.added}); %>
        <%- include('messages/detail',{})  %>
      <% }); %>

    </ul>

    <%- include('footer') %>

  </body>
</html>
